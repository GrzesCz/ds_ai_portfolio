---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const metrics = [
  { value: 'PDF', label: 'automatyczny skład', icon: '🖨️' },
  { value: 'A3', label: 'broszura i plakaty', icon: '📄' },
  { value: 'S3', label: 'magazyn MinIO', icon: '📤' },
  { value: 'PROD', label: 'wdrożono na VPS', icon: '🚀' },
];

const challenges = [
  {
    title: 'Problem',
    description: 'Gazetka promocyjna wraca co dwa tygodnie, a razem z nią przepisywanie dziesiątek cen z systemu sprzedażowego sklepu do programu graficznego. Praca powolna, droga i podatna na błędy — przy każdej zmianie ceny robiona od nowa, mimo że układ strony pozostaje ten sam.',
    icon: '📋',
  },
  {
    title: 'Rozwiązanie',
    description: 'FlyerEngine bierze ceny prosto ze źródła — z pliku Excel, z bazy sklepu przez VPN albo z plików DBF pobieranych po SSH — i pamięta zdjęcia produktów po kodzie PLU, więc ten sam towar w kolejnej promocji ma zdjęcie od razu. Na wyjściu jest gotowy PDF: broszura A3 złożona w kolejności druku oraz plakaty A3 dla wybranych pozycji. Układ powstaje raz i pracuje przy każdej następnej gazetce.',
    icon: '🖨️',
  },
  {
    title: 'Sztuczna inteligencja: dwa konkretne miejsca',
    description: 'AI pracuje tam, gdzie naprawdę oszczędza czas, i nie udaje, że robi więcej. W aplikacji dotyka wyłącznie zdjęć: wycina tło modelem u2net i przerabia zdjęcie referencyjne (Gemini albo GPT) — funkcja dla administratora. Drugim miejscem jest mój warsztat: cały kod powstawał we współpracy z agentami AI, według własnych szablonów, z testami i twardymi bramkami jakości przed każdym scaleniem.',
    icon: '🤖',
  },
];

const completedItems = [
  'Wystawienie skalowalnego interfejsu REST API w oparciu o framework FastAPI',
  'Stworzenie nowoczesnego interfejsu użytkownika przy użyciu React i Node.js (Vite)',
  'Wdrożenie asynchronicznej kolejki zadań (Celery + Redis) do generowania dokumentów w tle',
  'Zintegrowanie systemu z magazynem obiektowym S3 (MinIO) do przechowywania plików',
  'Wdrożenie silnika renderującego Playwright oraz impozycji składającej strony A4 w arkusze A3',
  'Migracja całej architektury na dedykowany serwer VPS z automatycznym wdrożeniem po zielonym CI',
  'Implementacja warstwy dostępu do bazy danych PostgreSQL (SQLAlchemy async + Alembic)',
  'Rozliczanie kosztu wywołań AI w osobnym module, z przeliczeniem na złotówki po kursie NBP',
  'Opracowanie własnych, dedykowanych szablonów (AI Templates) standaryzujących pracę z Agentami AI',
];

const features = [
  'Baza produktów ze zdjęciami wiązanymi trwale po kodzie PLU — raz wgrane zdjęcie wraca w kolejnych gazetkach',
  'Import cen trzema kanałami: plik Excel lub CSV, baza sklepu przez VPN, pliki DBF pobierane po SSH',
  'Trzy szablony pierwszej strony i edytor układu: przeciąganie kafelków, przenoszenie rzędów, rozmiary kafelków',
  'Automatyczne renderowanie dokumentów PDF silnikiem Playwright — strony logiczne A4 składane impozycją w arkusze A3',
  'Plakaty A3 dla wybranych pozycji, generowane obok broszury z tych samych danych',
  'Wycinanie tła ze zdjęć (u2net) i edycja zdjęcia referencyjnego przez AI — dla administratora',
];

const techDetails = [
  { name: 'Frontend', value: 'React, Node.js (Vite)' },
  { name: 'Backend', value: 'Python 3.12+, FastAPI, Celery' },
  { name: 'Baza danych', value: 'PostgreSQL (SQLAlchemy async, psycopg3, Alembic)' },
  { name: 'Architektura', value: 'MinIO (S3), Redis, Docker, Playwright' },
  { name: 'AI & Code Gen', value: 'Vibe Engineering, Claude Code, Custom Skills' },
  { name: 'Status', value: 'Wdrożony na VPS (Produkcja)' },
];

const roles = [
  'Zebrałem wymagania od klienta i zaprojektowałem system: od pobrania cen ze źródła sklepu po plik gotowy do druku',
  'Zbudowałem warstwę renderującą (Playwright, szablony HTML/CSS) wraz z impozycją broszury w kolejności druku',
  'Zaimplementowałem asynchroniczny dostęp do PostgreSQL (SQLAlchemy async, psycopg3) i migracje Alembic',
  'Rozwijałem aplikację w oparciu o testy (TDD) oraz automatyczne wdrażanie kodu (GitHub Actions na VPS)',
  'Kierowałem pracą Agentów AI w trakcie pisania kodu — z własnymi szablonami, bramkami jakości i recenzją każdej zmiany',
];

const plannedItems = [
  'Ekran administratora do zarządzania nagłówkami gazetek i danymi sklepów',
  'Obsługa wielu cenników i kolejne źródła danych obok Excela, VPN oraz SFTP',
  'Przygotowanie pliku pod wymagania drukarni offsetowej: spady, znaczniki cięcia, CMYK i PDF/X',
];
---

<ProjectLayout
  title="FlyerEngine — Laboratorium Innowacji"
  description="Zautomatyzowany system do składu gazetek promocyjnych: ceny wchodzą wprost z systemu sprzedażowego sklepu, na wyjściu jest broszura A3 w kolejności druku."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-gray-500">
        <li><a href="/ds_ai_portfolio/" class="hover:text-purple-400 transition-colors">Strona główna</a></li>
        <li>/</li>
        <li><a href="/ds_ai_portfolio/#laboratorium" class="hover:text-purple-400 transition-colors">Laboratorium</a></li>
        <li>/</li>
        <li class="text-gray-300">FlyerEngine</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-12">
      <div class="inline-block bg-green-600 text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-4 shadow-lg shadow-green-600/30">
        Produkcja (Wdrożono na VPS)
      </div>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white mb-4">FlyerEngine (AI-Powered)</h1>
      <p class="text-gray-400 text-lg max-w-3xl mb-6">
        Zaawansowany system automatyzujący powtarzalny i żmudny skład gazetek promocyjnych. Ceny wchodzą do gazetki wprost ze źródła — z pliku Excel, z bazy sklepu przez VPN albo z plików DBF pobieranych po SSH — a zdjęcia wracają po kodzie produktu z magazynu. Operator układa stronę na podglądzie, system składa broszurę A3 w kolejności druku i plakaty A3. Sztuczna inteligencja pracuje przy zdjęciach: wycina tło i przerabia zdjęcie referencyjne.
      </p>
      <div class="flex flex-wrap gap-2">
        {['React', 'FastAPI', 'Celery', 'PostgreSQL', 'Vibe Engineering', 'Agentic AI'].map((tag) => (
          <span class="px-3 py-1 text-xs bg-purple-500/10 text-purple-400 rounded-md border border-purple-500/20">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Pełny materiał o systemie -->
    <a
      href="/ds_ai_portfolio/projects/flyer-engine/prospekt/"
      class="group block bg-card border border-purple-500/30 rounded-xl p-6 mb-16 hover:border-purple-400 transition-colors"
    >
      <div class="flex items-start justify-between gap-6">
        <div>
          <h2 class="text-xl font-bold text-white mb-2">Zobacz, jak to działa</h2>
          <p class="text-gray-400 text-sm max-w-3xl">
            Pełny materiał o systemie: skąd biorą się ceny i zdjęcia, jak powstaje układ
            strony, co dostaje drukarnia. Prawdziwe wydruki z silnika i dwie animacje
            pokazujące edytor układu.
          </p>
        </div>
        <span class="text-purple-400 text-2xl group-hover:translate-x-1 transition-transform flex-shrink-0">→</span>
      </div>
    </a>

    <!-- Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-16">
      {metrics.map((m) => (
        <div class="bg-card border border-gray-800 rounded-xl p-5 text-center">
          <div class="text-3xl mb-2">{m.icon}</div>
          <div class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-200">
            {m.value}
          </div>
          <p class="text-gray-400 text-sm mt-1">{m.label}</p>
        </div>
      ))}
    </div>

    <!-- Zapotrzebowanie / Rozwiązanie / Status -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Od zapotrzebowania do rozwiązania</h2>
      <div class="space-y-6">
        {challenges.map((c) => (
          <div class="bg-card border border-gray-800 rounded-xl p-6">
            <div class="flex items-start gap-4">
              <span class="text-2xl flex-shrink-0">{c.icon}</span>
              <div>
                <h3 class="text-white font-bold text-lg mb-2">{c.title}</h3>
                <p class="text-gray-400 leading-relaxed">{c.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Co zrobiłem -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Co zrobiłem</h2>
      <div class="space-y-3">
        {completedItems.map((item) => (
          <div class="flex items-start gap-3 bg-card border border-gray-800 rounded-lg p-4">
            <span class="text-emerald-400 mt-0.5 flex-shrink-0">✓</span>
            <span class="text-gray-300 text-sm">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Co jest w planach -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Co jest w planach</h2>
      <div class="space-y-3">
        {plannedItems.map((item) => (
          <div class="flex items-start gap-3 bg-card border border-gray-800 rounded-lg p-4">
            <span class="text-purple-400 mt-0.5 flex-shrink-0">▸</span>
            <span class="text-gray-300 text-sm">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Features -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Kluczowe funkcjonalności</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {features.map((f) => (
          <div class="flex items-start gap-3 bg-card border border-gray-800 rounded-lg p-4">
            <span class="text-purple-400 mt-0.5 flex-shrink-0">▸</span>
            <span class="text-gray-300 text-sm">{f}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Tech Details -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Stack technologiczny</h2>
      <div class="bg-card border border-gray-800 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
          {techDetails.map((t, i) => (
            <tr class={i % 2 === 0 ? 'bg-card' : 'bg-primary/30'}>
              <td class="px-6 py-3 text-gray-500 font-medium w-1/3">{t.name}</td>
              <td class="px-6 py-3 text-gray-300">{t.value}</td>
            </tr>
          ))}
        </table>
      </div>
    </div>

    <!-- My Role -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-white mb-6">Moja rola</h2>
      <div class="bg-card border border-gray-800 rounded-xl p-6">
        <p class="text-gray-400 leading-relaxed mb-4">
          Odpowiadam za cały projekt — od zebrania wymagań od klienta po pełną implementację backendu. Wykorzystuję zaawansowane wzorce projektowe (m.in. z zakresu Domain-Driven Design i czystej architektury):
        </p>
        <ul class="space-y-3">
          {roles.map((r) => (
            <li class="text-gray-300 flex items-start gap-3">
              <span class="text-purple-400 mt-1 flex-shrink-0">✓</span>
              <span>{r}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Back -->
    <div class="flex gap-4 items-start">
      <a
        href="/ds_ai_portfolio/#laboratorium"
        class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors"
      >
        ← Wróć do sekcji Laboratorium
      </a>
      <a
        href="/ds_ai_portfolio/projects/flyer-engine/prospekt/"
        class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 transition-colors"
      >
        Pełny materiał o systemie →
      </a>
    </div>
  </div>
</ProjectLayout>